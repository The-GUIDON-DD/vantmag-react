{
  "name": "interactive-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "format": "pnpx @biomejs/biome format --write ./",
    "lint": "pnpx @biomejs/biome lint --write ./",
    "check": "pnpx @biomejs/biome check",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && wrangler dev",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "2.6.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "@tanstack/react-query": "^5.104.5",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "html-react-parser": "^6.1.8",
    "isomorphic-dompurify": "^4.6.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router": "^8.5.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "isbot": "^5.2.2",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3",
    "zod": "^4.6.7"
  }
}
