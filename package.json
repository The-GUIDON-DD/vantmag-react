{
  "name": "interactive-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "format": "pnpx @biomejs/biome format --write ./",
    "lint": "pnpx @biomejs/biome lint --write ./",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && wrangler dev",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "animejs": "^4.5.0",
    "biome": "^0.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "isbot": "^5.2.1",
    "lefthook": "^2.1.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.124.0"
  }
}
