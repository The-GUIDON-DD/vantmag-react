{
  "name": "interactive-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "format": "pnpx @biomejs/biome format --write ./",
    "lint": "pnpx @biomejs/biome lint --write ./",
    "check": "pnpx @biomejs/biome check",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && wrangler dev",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "@tanstack/react-query": "^5.102.8",
    "animejs": "^4.5.0",
    "biome": "^0.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "isbot": "^5.2.2",
    "lefthook": "^2.1.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  }
}
